# Narrative Engine API — copy to .env (never commit .env)
# See docs/narrative-engine/environments.md for dev vs prod

# --- Local development (recommended) ---
NODE_ENV=development
APP_ENV=development
PORT=3001

# DEV Supabase project only — use a separate project from production
# Project Settings → API (https URL, not postgresql://)
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Leave REDIS_URL empty locally → pipeline runs inline (simplest path)
REDIS_URL=
WORKER_MODE=false

CORS_ORIGIN=http://localhost:5173
ADMIN_API_KEY=local-dev-admin-key

X402_PAY_TO=
X402_FACILITATOR_URL=https://facilitator.xpay.sh
RERUN_PRICE_USDC=10
HUMAN_UNLOCK_PRICE_USDC=0.10
API_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Privy (human OAuth unlock)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Resend — results email + admin run-completion notifications
# API key alone is not enough: verify your sending domain in the Resend dashboard first.
# See docs/narrative-engine/resend-email-setup.md
RESEND_API_KEY=
RESULTS_EMAIL_FROM=Memetic Brand Labs <results@memetic.adpr.work>
IP_HASH_SALT=change-me-local-only
STORAGE_BUCKET=share-graphics
ADMIN_PLAYGROUND_DAILY_LIMIT=50

# Pattern Library injection into L2–L5 prompts (off until retrieval is reworked)
PATTERN_LIBRARY_ENABLED=false

# --- Production (set in Render dashboard, not in this file) ---
# NODE_ENV=production
# APP_ENV=production
# REDIS_URL=rediss://default:...@....upstash.io:6379
# WORKER_MODE=false   # web service
# WORKER_MODE=true    # worker service only
# CORS_ORIGIN=https://memetic.adpr.work
