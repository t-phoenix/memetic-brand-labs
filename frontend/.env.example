# Frontend — copy to .env or .env.local (never commit)
# See docs/narrative-engine/environments.md

# --- Local development ---
VITE_API_URL=http://localhost:3001

# Same DEV Supabase project as narrative-engine-api/.env
VITE_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Google Analytics 4 (production builds only)
VITE_GA_MEASUREMENT_ID=G-BVW6SV0RDG

# Optional — x402 wallet rerun on Base mainnet
VITE_WALLET_CONNECT_PROJECT_ID=
VITE_BASE_CHAIN_ID=8453

# Discovery links on marketing site (navbar + landing CTA).
# Omitted locally — Vite dev mode shows them automatically.
# VITE_NE_DISCOVERY=false

# Optional — pre-fill admin key in local dev (sessionStorage at runtime)
# VITE_ADMIN_API_KEY=local-dev-admin-key

# --- Production (Vercel dashboard) ---
# VITE_API_URL=https://your-api.onrender.com
# VITE_SUPABASE_URL=https://your-prod-project.supabase.co
# Never set VITE_ADMIN_API_KEY in production
